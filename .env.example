# Copy to .env.local for local overrides. All VITE_* values are bundled into the
# public client — never put secrets here.

# Canonical site URL, used for canonical/OG tags.
VITE_SITE_URL=https://your-domain.vercel.app

# Optional: a form endpoint (e.g. Formspree) for the contact form.
# When empty, the form opens the visitor's email client instead.
VITE_CONTACT_FORM_ENDPOINT=
